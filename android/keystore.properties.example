# Copie para keystore.properties (NÃO commitar) e preencha:
#   copy keystore.properties.example keystore.properties
#
# Gere o keystore (uma vez) na pasta android/:
#   keytool -genkeypair -v -keystore platonia-release.keystore -alias platonia -keyalg RSA -keysize 2048 -validity 10000
#
# Guarde a senha e o .keystore em local seguro (backup!). Perder = não atualizar o app na Play Store.

storeFile=platonia-release.keystore
storePassword=COLOQUE_A_SENHA_AQUI
keyAlias=platonia
keyPassword=COLOQUE_A_SENHA_AQUI
